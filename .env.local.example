# Database
# Local: use Docker Compose Postgres
POSTGRES_URL=postgresql://farmintel:farmintel@localhost:5432/farmintel
# Vercel/Neon: use your Neon connection string
# POSTGRES_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/farmintel?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# OAuth (GitHub) – optional for dev
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# File uploads (local dev uses filesystem)
UPLOAD_DIR=./uploads

# Census Bureau API key – optional, increases rate limit
# Get one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# FRED API key – optional, enables home price index data
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
